{
  "_comment": "门禁注册表。run_gates.py 读取；每条 gate 的 args 里的 {name} 从项目配置 paper.gates.json 取值。requires 里的键缺失时该门 SKIPPED（硬门被跳过则整体不得判 FROZEN_OK）。severity=hard 不可补偿；severity=soft 只产生热区，永不失败。阈值只放这里，不写进脚本默认值以外的地方。",
  "version": 1,
  "exit_semantics": {"0": "PASS", "1": "HARD_FAIL", "2": "ERROR", "4": "REVIEW_REQUIRED"},
  "verdicts": {
    "BLOCKED": "契约门失败或工具错误：禁止改稿，先修契约/环境",
    "TARGETED": "硬门失败：按 unit 清单与 reason_code 定点修，每 unit 一张卡片、同维度 ≤2 次",
    "REVIEW": "只剩待审项或软热区：人工判定，写豁免或改",
    "FROZEN_OK": "硬门全过、无待审、热区低于阈值：停止；再改只能由导师意见或新事实触发"
  },
  "gates": [
    {
      "id": "macro_zero_change",
      "layer": 0,
      "severity": "hard",
      "on_fail": "BLOCKED",
      "script": "macro_diff.py",
      "args": ["{macro_base}", "{macro_new}"],
      "requires": ["macro_base", "macro_new"],
      "doc": "references/06-evidence.md §一",
      "why": "既有宏一个都不能变；改了就是数据漂移，任何文字改动都建立在错的数字上"
    },
    {
      "id": "page_delta",
      "layer": 0,
      "severity": "hard",
      "on_fail": "BLOCKED",
      "script": "page_delta.py",
      "args": ["{pdf_base}", "{pdf}", "--strip-ws"],
      "requires": ["pdf_base", "pdf"],
      "doc": "references/09-mechanics.md §六",
      "why": "残差非零即存在未申报改动；归因项通过 attributions 键传入"
    },
    {
      "id": "claim_ledger",
      "layer": 1,
      "severity": "hard",
      "on_fail": "TARGETED",
      "script": "claim_ledger.py",
      "args": ["--config", "{config}"],
      "requires": ["outline"],
      "doc": "references/01-skeleton.md §一.4；references/02-narrative.md 摘要硬规则",
      "why": "主张必须挂证据与边界；结果章做了外部基线比较而摘要不提，是本方法记录到的最贵事故"
    },
    {
      "id": "hedge_budget",
      "layer": 3,
      "severity": "hard",
      "on_fail": "TARGETED",
      "script": "hedge_budget.py",
      "args": ["--config", "{config}", "--per20", "10", "--lcs", "12"],
      "requires": [],
      "doc": "references/04-hedging.md §二",
      "why": "上限防堆砌、位置防扩散、下限防删光——成对规则的机器版"
    },
    {
      "id": "jargon_scan",
      "layer": 3,
      "severity": "hard",
      "on_fail": "TARGETED",
      "script": "jargon_scan.py",
      "args": ["--patterns", "{banned_terms}", "--tex", "{sections}", "--exclude-env", "algorithmic", "--pdf", "{pdf}"],
      "requires": ["banned_terms", "pdf"],
      "exemption_rule": "命中数 = 已人工判定豁免数，每条豁免在报告里列理由；退出码 1 不自动等于失败",
      "doc": "references/03-diction.md §八",
      "why": "图内标签由绘图脚本继承变量名，源码 grep 不到"
    },
    {
      "id": "page_fill",
      "layer": 5,
      "severity": "hard",
      "on_fail": "TARGETED",
      "script": "page_fill.py",
      "args": ["--pdf", "{pdf}", "--threshold", "0.35", "--exemptions", "{exemptions}"],
      "requires": ["pdf"],
      "doc": "references/09-mechanics.md §十",
      "why": "\\FloatBarrier / 浮动体推挤造成的半空页只在页级可见"
    }
  ]
}
